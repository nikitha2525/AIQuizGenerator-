# AI Provider
OPENAI_API_KEY=your_openai_api_key_here

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
NODE_ENV=development

# Quiz Settings
MAX_QUESTIONS_PER_QUIZ=15
MIN_QUESTIONS_PER_QUIZ=5
DEFAULT_QUESTIONS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE_MB=10

# For production (switch to PostgreSQL via Supabase/Neon):
# DATABASE_URL="postgresql://user:password@host:5432/cortex?schema=public"
